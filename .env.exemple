PORT=4816
NODE_ENV=production
SITE_URL=https://link2me.fr

# Clé secrète de session — génère avec: node -e "require('crypto').randomBytes(64).toString('hex')|cat"
SESSION_SECRET=

# ── GitHub OAuth ──────────────────────────────────────────────
# https://github.com/settings/developers → New OAuth App
# Callback URL: https://link2me.arionyq.fr/auth/github/callback
GITHUB_CLIENT_ID= 
GITHUB_CLIENT_SECRET=

# ── Google OAuth ──────────────────────────────────────────────
# https://console.cloud.google.com/ → APIs & Services → Credentials
# Callback URL: https://link2me.arionyq.fr/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Discord OAuth ─────────────────────────────────────────────
# https://discord.com/developers/applications → New Application → OAuth2
# Callback URL: https://link2me.arionyq.fr/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=