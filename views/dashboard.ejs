<%- include('partials/head', { title: 'Dashboard' }) %>
<body class="dashboard-page">
    <%- include('partials/nav', { user: user, currentPage: 'dashboard' }) %>

    <div class="dashboard-container">
        <!-- Welcome Section -->
        <div class="dashboard-welcome">
            <div class="dashboard-welcome-content">
                <h1>Salut, <%= pageConfig.displayName || user.username %> 👋</h1>
                <p>Bienvenue sur ton dashboard. Voici un aperçu de ton activité.</p>
            </div>
            <div class="dashboard-welcome-actions">
                <a href="/editor" class="btn btn-primary">
                    <i class="fa-solid fa-pen-to-square"></i>
                    Éditer mon profil
                </a>
                <a href="/<%= user.username %>" class="btn btn-ghost" target="_blank">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    Voir mon profil
                </a>
            </div>
        </div>

        <!-- Stats Grid -->
        <div class="dashboard-stats">
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <i class="fa-solid fa-eye"></i>
                </div>
                <div class="dashboard-stat-info">
                    <span class="dashboard-stat-number"><%= (typeof stats !== 'undefined' ? (stats.totalViews || 0) : 0) %></span>
                    <span class="dashboard-stat-label">Vues totales</span>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <i class="fa-solid fa-arrow-pointer"></i>
                </div>
                <div class="dashboard-stat-info">
                    <span class="dashboard-stat-number"><%= (typeof stats !== 'undefined' ? (stats.totalClicks || 0) : 0) %></span>
                    <span class="dashboard-stat-label">Clics totaux</span>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <i class="fa-solid fa-link"></i>
                </div>
                <div class="dashboard-stat-info">
                    <span class="dashboard-stat-number"><%= pageConfig?.custom_links?.length || 0 %></span>
                    <span class="dashboard-stat-label">Liens</span>
                </div>
            </div>
            <div class="dashboard-stat-card">
                <div class="dashboard-stat-icon">
                    <i class="fa-solid fa-award"></i>
                </div>
                <div class="dashboard-stat-info">
                    <span class="dashboard-stat-number"><%= typeof badges !== 'undefined' ? badges.length : 0 %></span>
                    <span class="dashboard-stat-label">Badges</span>
                </div>
            </div>
        </div>

        <!-- Quick Info -->
        <div class="dashboard-grid">
            <!-- Profile URL -->
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h3><i class="fa-solid fa-globe"></i> Ton profil</h3>
                </div>
                <div class="dashboard-card-body">
                    <div class="profile-url-copy">
                        <span class="profile-url"><%= siteUrl %>/<strong><%= user.username %></strong></span>
                        <button class="btn btn-small btn-ghost" onclick="navigator.clipboard.writeText('<%= siteUrl %>/<%= user.username %>')">
                            <i class="fa-solid fa-copy"></i> Copier
                        </button>
                    </div>
                    <div class="dashboard-profile-info">
                        <span><i class="fa-solid fa-palette"></i> Thème : <strong><%= pageConfig.theme || 'dark' %></strong></span>
                        <span><i class="fa-solid fa-font"></i> Police : <strong><%= pageConfig.font || 'Inter' %></strong></span>
                        <span><i class="fa-solid fa-wand-magic-sparkles"></i> Effet : <strong><%= pageConfig.particles || 'Aucun' %></strong></span>
                    </div>
                </div>
            </div>

            <!-- Recent Activity -->
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h3><i class="fa-solid fa-clock"></i> Activité récente</h3>
                </div>
                <div class="dashboard-card-body">
                    <div class="activity-list">
                        <% if (pageConfig.bio) { %>
                        <div class="activity-item">
                            <i class="fa-solid fa-circle"></i>
                            <span>Profil configuré avec succès</span>
                            <span class="activity-time">Actif</span>
                        </div>
                        <% } %>
                        <% if (user.lastLoginAt) { %>
                        <div class="activity-item">
                            <i class="fa-solid fa-circle"></i>
                            <span>Dernière connexion</span>
                            <span class="activity-time"><%= new Date(user.lastLoginAt).toLocaleDateString('fr-FR') %></span>
                        </div>
                        <% } %>
                        <div class="activity-item">
                            <i class="fa-solid fa-circle"></i>
                            <span>Compte créé</span>
                            <span class="activity-time"><%= user.created_at ? new Date(user.created_at).toLocaleDateString('fr-FR') : 'N/A' %></span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Badges -->
            <% if (typeof badges !== 'undefined' && badges.length) { %>
            <div class="dashboard-card">
                <div class="dashboard-card-header">
                    <h3><i class="fa-solid fa-award"></i> Tes badges</h3>
                </div>
                <div class="dashboard-card-body">
                    <div class="badges-display">
                        <% badges.forEach(function(badge) { %>
                        <div class="badge-item" title="<%= badge.name %>">
                            <i class="fa-solid <%= badge.icon || 'fa-star' %>"></i>
                            <span><%= badge.name %></span>
                        </div>
                        <% }); %>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Danger Zone -->
            <div class="dashboard-card dashboard-card-danger">
                <div class="dashboard-card-header">
                    <h3><i class="fa-solid fa-triangle-exclamation"></i> Zone de danger</h3>
                </div>
                <div class="dashboard-card-body">
                    <p>Supprimer ton compte est irréversible. Toutes tes données seront effacées.</p>
                    <form action="/api/delete-account" method="POST" onsubmit="return confirm('Es-tu sûr de vouloir supprimer ton compte ? Cette action est IRRÉVERSIBLE.')">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash"></i>
                            Supprimer mon compte
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>