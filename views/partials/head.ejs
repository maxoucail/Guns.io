<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#0a0a0a">
    <meta name="description" content="Guns.io — Crée ton profil unique. Le meilleur créateur de pages de liens, inspiré par gun.lol. Gratuit, stylé, puissant.">
    <meta name="keywords" content="guns.io, link in bio, page de liens, profil personnalisé, créateur de profil, gun.lol, alternative gun.lol">
    <meta name="author" content="Guns.io">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph -->
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title + ' — Guns.io' : 'Guns.io — Crée ton profil ultime' %>">
    <meta property="og:description" content="Le meilleur créateur de pages de liens. Effets visuels, polices, badges, et bien plus.">
