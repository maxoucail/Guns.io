<!doctype html>
<html lang="fr">
<head>
  <%- include('partials/head') %>
</head>
<body class="page-auth">
  <div class="aurora" aria-hidden="true"><span></span><span></span><span></span></div>
  <div class="grain" aria-hidden="true"></div>

  <main class="auth-shell">
    <a href="/" class="brand-stack">
      <span class="brand-mark big"></span>
      <span class="brand-name big">link2me</span>
    </a>
    <h1 class="auth-title">Connecte-toi</h1>
    <p class="auth-sub">Garde un seul compte. Choisis ton fournisseur.</p>

    <% if (error === 'blocked') { %>
      <div class="alert" style="border-color:rgba(255,108,171,0.4);color:#fda4b1">Ton compte a été suspendu. Contacte le support.</div>
    <% } else if (error) { %>
      <div class="alert">Connexion impossible. Réessaie ou choisis un autre provider.</div>
    <% } %>

    <div class="provider-stack">
      <% if (googleEnabled) { %>
        <a class="provider google" href="/auth/google">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" width="22" height="22"><path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.6 29.3 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3 0 5.8 1.1 7.9 3l5.7-5.7C34 5.1 29.3 3 24 3 12.4 3 3 12.4 3 24s9.4 21 21 21 21-9.4 21-21c0-1.2-.1-2.3-.4-3.5z"/><path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 16 19 13 24 13c3 0 5.8 1.1 7.9 3l5.7-5.7C34 5.1 29.3 3 24 3 16.1 3 9.3 7.6 6.3 14.7z"/><path fill="#4CAF50" d="M24 45c5.2 0 9.9-2 13.4-5.2l-6.2-5.1C29.1 36 26.7 37 24 37c-5.3 0-9.7-3.4-11.3-8.1l-6.5 5C9.2 40.4 16 45 24 45z"/><path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.3-2.3 4.3-4.2 5.7l6.2 5.1C40 35.9 45 30.5 45 24c0-1.2-.1-2.3-.4-3.5z"/></svg>
          </span>
          <span>Continuer avec Google</span>
        </a>
      <% } %>
      <% if (discordEnabled) { %>
        <a class="provider discord" href="/auth/discord">
          <span class="icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="#fff"><path d="M20.317 4.369A19.79 19.79 0 0 0 16.558 3a14.86 14.86 0 0 0-.689 1.418 18.27 18.27 0 0 0-5.736 0A14.7 14.7 0 0 0 9.444 3a19.74 19.74 0 0 0-3.76 1.369C2.103 9.842 1.13 15.149 1.61 20.38a19.94 19.94 0 0 0 6.046 3.062c.49-.668.93-1.378 1.308-2.12a12.92 12.92 0 0 1-2.062-.992c.173-.128.342-.262.504-.4a14.07 14.07 0 0 0 12.188 0c.165.14.333.273.504.4a12.86 12.86 0 0 1-2.066.994c.377.74.816 1.45 1.308 2.118a19.92 19.92 0 0 0 6.05-3.062c.554-6.07-1.045-11.33-3.073-16.011zM8.02 16.43c-1.183 0-2.157-1.09-2.157-2.43s.955-2.43 2.157-2.43c1.203 0 2.176 1.09 2.157 2.43 0 1.34-.955 2.43-2.157 2.43zm7.96 0c-1.183 0-2.157-1.09-2.157-2.43s.955-2.43 2.157-2.43c1.203 0 2.176 1.09 2.157 2.43 0 1.34-.955 2.43-2.157 2.43z"/></svg>
          </span>
          <span>Continuer avec Discord</span>
        </a>
      <% } %>
      <% if (!googleEnabled && !discordEnabled) { %>
        <div class="alert">Aucun provider OAuth configuré. Renseigne les clés dans le .env.</div>
      <% } %>
    </div>

    <p class="auth-foot">En continuant, tu acceptes que ton pseudo et avatar provider soient utilisés pour créer ton profil.</p>
    <a href="/" class="back-link">← Retour à l'accueil</a>
  </main>
</body>
</html>
