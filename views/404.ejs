<%- include('partials/head', { title: 'Page introuvable' }) %>
<body class="error-page">
    <div class="error-container">
        <div class="error-code">
            <span class="error-digit">4</span>
            <span class="error-zero">
                <i class="fa-solid fa-gun error-zero-icon"></i>
            </span>
            <span class="error-digit">4</span>
        </div>
        <h1 class="error-title">Page introuvable</h1>
        <p class="error-desc">La page que tu cherches n'existe pas ou a été déplacée. Mais pas de panique, tu peux toujours créer ton profil !</p>
        <div class="error-actions">
            <a href="/" class="btn btn-primary">
                <i class="fa-solid fa-house"></i>
                Retour à l'accueil
            </a>
            <a href="/auth/github" class="btn btn-ghost">
                <i class="fa-brands fa-github"></i>
                Créer un profil
            </a>
        </div>
    </div>
    <div class="error-bg">
        <div class="error-bg-grid"></div>
    </div>
</body>
</html>
