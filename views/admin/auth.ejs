<%- include('../partials/head', { title: 'Admin Auth' }) %>
<body class="admin-page">
    <%- include('../partials/nav', { user: user, currentPage: 'admin' }) %>

    <div class="admin-container">
        <div class="admin-header">
            <a href="/admin" class="admin-back">
                <i class="fa-solid fa-arrow-left"></i> Retour
            </a>
            <h1><i class="fa-solid fa-key"></i> Authentification Admin</h1>
            <p>Gère l'accès administrateur au site.</p>
        </div>

        <div class="admin-card-content">
            <form action="/admin/auth" method="POST" class="admin-form">
                <div class="form-group">
                    <label for="adminPassword">Mot de passe administrateur</label>
                    <input type="password" id="adminPassword" name="password" placeholder="Entrer le mot de passe admin..." required>
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-lock"></i>
                    S'authentifier
                </button>
            </form>
        </div>
    </div>
</body>
</html>