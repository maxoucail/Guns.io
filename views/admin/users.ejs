<%- include('../partials/head', { title: 'Admin — Utilisateurs' }) %>
<body class="admin-page">
    <%- include('../partials/nav', { user: user, currentPage: 'admin' }) %>

    <div class="admin-container">
        <div class="admin-header">
            <a href="/admin" class="admin-back">
                <i class="fa-solid fa-arrow-left"></i> Retour
            </a>
            <h1><i class="fa-solid fa-users"></i> Utilisateurs</h1>
            <p>Gère tous les utilisateurs de la plateforme.</p>
        </div>

        <div class="admin-users-search">
            <input type="text" id="userSearch" placeholder="Rechercher un utilisateur..." class="admin-search-input">
        </div>

        <div class="admin-table-wrapper">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Utilisateur</th>
                        <th>GitHub ID</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Profil</th>
                        <th>Vues</th>
                        <th>Inscrit le</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="usersTableBody">
                    <% if (users?.length) { %>
                        <% users.forEach(function(u) { %>
                        <tr data-username="<%= u.username %>" data-github="<%= u.githubId %>">
                            <td class="admin-user-cell">
                                <img src="<%= u.avatar || 'https://github.com/' + u.username + '.png?size=40' %>" alt="<%= u.username %>" class="admin-user-avatar" onerror="this.style.display='none'">
                                <div>
                                    <strong><%= u.displayName || u.username %></strong>
                                    <small>@<%= u.username %></small>
                                </div>
                            </td>
                            <td><code><%= u.githubId %></code></td>
                            <td>
                                <span class="admin-role-badge role-<%= u.role %>">
                                    <%= u.role || 'user' %>
                                </span>
                            </td>
                            <td>
                                <span class="admin-status-badge status-<%= u.blocked ? 'blocked' : 'active' %>">
                                    <%= u.blocked ? 'Bloqué' : 'Actif' %>
                                </span>
                            </td>
                            <td>
                                <% if (u.profileId) { %>✅<% } else { %>
                                <span class="muted">—</span>
                                <% } %>
                            </td>
                            <td><%= u.stats?.totalViews || 0 %></td>
                            <td><%= new Date(u.createdAt).toLocaleDateString('fr-FR') %></td>
                            <td class="admin-actions-cell">
                                <a href="/admin/users/<%= u._id || u.id %>" class="btn btn-small btn-ghost">
                                    <i class="fa-solid fa-eye"></i>
                                </a>
                                <% if (!u.blocked) { %>
                                <form action="/admin/users/<%= u._id || u.id %>/block" method="POST" style="display:inline">
                                    <button type="submit" class="btn btn-small btn-warning" onclick="return confirm('Bloquer <%= u.username %> ?')">
                                        <i class="fa-solid fa-ban"></i>
                                    </button>
                                </form>
                                <% } else { %>
                                <form action="/admin/users/<%= u._id || u.id %>/unblock" method="POST" style="display:inline">
                                    <button type="submit" class="btn btn-small btn-success">
                                        <i class="fa-solid fa-check"></i>
                                    </button>
                                </form>
                                <% } %>
                                <form action="/admin/users/<%= u._id || u.id %>/delete" method="POST" style="display:inline" onsubmit="return confirm('SUPPRIMER <%= u.username %> ? IRRÉVERSIBLE !')">
                                    <button type="submit" class="btn btn-small btn-danger">
                                        <i class="fa-solid fa-trash"></i>
                                    </button>
                                </form>
                            </td>
                        </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="8" class="admin-empty">Aucun utilisateur trouvé.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <script>
    document.getElementById('userSearch')?.addEventListener('input', function() {
        const query = this.value.toLowerCase();
        document.querySelectorAll('#usersTableBody tr').forEach(row => {
            const username = (row.dataset.username || '').toLowerCase();
            const github = (row.dataset.github || '').toLowerCase();
            row.style.display = (!query || username.includes(query) || github.includes(query)) ? '' : 'none';
        });
    });
    </script>
</body>
</html>