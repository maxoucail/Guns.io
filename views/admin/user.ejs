<%- include('../partials/head', { title: 'Admin — ' + (targetUser.username || 'Utilisateur') }) %>
<body class="admin-page">
    <%- include('../partials/nav', { user: user, currentPage: 'admin' }) %>

    <div class="admin-container">
        <div class="admin-header">
            <a href="/admin/users" class="admin-back">
                <i class="fa-solid fa-arrow-left"></i> Retour
            </a>
            <h1><i class="fa-solid fa-user"></i> <%= targetUser.displayName || targetUser.username %></h1>
            <p>@<%= targetUser.username %> — GitHub ID: <code><%= targetUser.githubId %></code></p>
        </div>

        <div class="admin-user-details">
            <div class="admin-user-card">
                <div class="admin-user-card-header">
                    <img src="<%= targetUser.avatar || 'https://github.com/' + targetUser.username + '.png?size=80' %>" alt="<%= targetUser.username %>" class="admin-user-large-avatar" onerror="this.style.display='none'">
                    <div>
                        <h2><%= targetUser.displayName || targetUser.username %></h2>
                        <p>@<%= targetUser.username %></p>
                        <span class="admin-role-badge role-<%= targetUser.role %>"><%= targetUser.role || 'user' %></span>
                        <span class="admin-status-badge status-<%= targetUser.blocked ? 'blocked' : 'active' %>"><%= targetUser.blocked ? 'Bloqué' : 'Actif' %></span>
                    </div>
                </div>
                <div class="admin-user-card-body">
                    <div class="admin-user-info-item">
                        <span>Email</span>
                        <span><%= targetUser.email || 'Non renseigné' %></span>
                    </div>
                    <div class="admin-user-info-item">
                        <span>GitHub ID</span>
                        <span><code><%= targetUser.githubId %></code></span>
                    </div>
                    <div class="admin-user-info-item">
                        <span>Inscrit le</span>
                        <span><%= new Date(targetUser.createdAt).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %></span>
                    </div>
                    <div class="admin-user-info-item">
                        <span>Dernière connexion</span>
                        <span><%= targetUser.lastLogin ? new Date(targetUser.lastLogin).toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Inconnue' %></span>
                    </div>
                </div>
            </div>

            <div class="admin-user-card">
                <h3>Profil</h3>
                <% if (targetProfile) { %>
                <div class="admin-user-info-item">
                    <span>Thème</span>
                    <span><%= targetProfile.theme || 'dark' %></span>
                </div>
                <div class="admin-user-info-item">
                    <span>Effet</span>
                    <span><%= targetProfile.effect || 'Aucun' %></span>
                </div>
                <div class="admin-user-info-item">
                    <span>Police</span>
                    <span><%= targetProfile.font || 'Inter' %></span>
                </div>
                <div class="admin-user-info-item">
                    <span>Liens</span>
                    <span><%= targetProfile.links?.length || 0 %></span>
                </div>
                <div class="admin-user-info-item">
                    <span>Musiques</span>
                    <span><%= targetProfile.music?.length || 0 %></span>
                </div>
                <div class="admin-user-info-item">
                    <span>Badges</span>
                    <span><%= targetProfile.badges?.length || 0 %></span>
                </div>
                <a href="/<%= targetUser.username %>" target="_blank" class="btn btn-ghost btn-small">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Voir le profil public
                </a>
                <% } else { %>
                <p class="muted">Aucun profil configuré.</p>
                <% } %>
            </div>

            <div class="admin-user-card">
                <h3>Statistiques</h3>
                <div class="admin-user-info-item">
                    <span>Vues totales</span>
                    <span><%= targetUser.stats?.totalViews || 0 %></span>
                </div>
                <div class="admin-user-info-item">
                    <span>Clics totaux</span>
                    <span><%= targetUser.stats?.totalClicks || 0 %></span>
                </div>
                <div class="admin-user-info-item">
                    <span>Visiteurs uniques</span>
                    <span><%= targetUser.stats?.uniqueVisitors || 0 %></span>
                </div>
            </div>

            <!-- Impersonation -->
            <div class="admin-user-card">
                <h3>Actions</h3>
                <div class="admin-actions-grid">
                    <form action="/admin/users/<%= targetUser._id || targetUser.id %>/impersonate" method="POST">
                        <button type="submit" class="btn btn-ghost">
                            <i class="fa-solid fa-mask"></i>
                            Impersonate (se connecter en tant que <%= targetUser.username %>)
                        </button>
                    </form>
                    <% if (targetUser.blocked) { %>
                    <form action="/admin/users/<%= targetUser._id || targetUser.id %>/unblock" method="POST">
                        <button type="submit" class="btn btn-success">
                            <i class="fa-solid fa-unlock"></i>
                            Débloquer l'utilisateur
                        </button>
                    </form>
                    <% } else { %>
                    <form action="/admin/users/<%= targetUser._id || targetUser.id %>/block" method="POST" onsubmit="return confirm('Bloquer <%= targetUser.username %> ?')">
                        <button type="submit" class="btn btn-warning">
                            <i class="fa-solid fa-ban"></i>
                            Bloquer l'utilisateur
                        </button>
                    </form>
                    <% } %>
                    <form action="/admin/users/<%= targetUser._id || targetUser.id %>/delete" method="POST" onsubmit="return confirm('SUPPRIMER <%= targetUser.username %> ? IRRÉVERSIBLE !')">
                        <button type="submit" class="btn btn-danger">
                            <i class="fa-solid fa-trash"></i>
                            Supprimer l'utilisateur
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</body>
</html>