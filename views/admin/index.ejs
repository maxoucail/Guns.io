<%- include('../partials/head', { title: 'Admin' }) %>
<body class="admin-page">
    <%- include('../partials/nav', { user: user, currentPage: 'admin' }) %>

    <div class="admin-container">
        <div class="admin-header">
            <h1><i class="fa-solid fa-shield-halved"></i> Administration</h1>
            <p>Gère les utilisateurs, les badges, et les paramètres du site.</p>
        </div>

        <div class="admin-stats">
            <div class="admin-stat-card">
                <i class="fa-solid fa-users"></i>
                <span class="admin-stat-number"><%= stats?.totalUsers || 0 %></span>
                <span class="admin-stat-label">Utilisateurs</span>
            </div>
            <div class="admin-stat-card">
                <i class="fa-solid fa-user-check"></i>
                <span class="admin-stat-number"><%= stats?.activeUsers || 0 %></span>
                <span class="admin-stat-label">Actifs</span>
            </div>
            <div class="admin-stat-card">
                <i class="fa-solid fa-user-slash"></i>
                <span class="admin-stat-number"><%= stats?.blockedUsers || 0 %></span>
                <span class="admin-stat-label">Bloqués</span>
            </div>
            <div class="admin-stat-card">
                <i class="fa-solid fa-eye"></i>
                <span class="admin-stat-number"><%= stats?.totalViews || 0 %></span>
                <span class="admin-stat-label">Vues totales</span>
            </div>
        </div>

        <div class="admin-grid">
            <a href="/admin/users" class="admin-card">
                <i class="fa-solid fa-users"></i>
                <h3>Utilisateurs</h3>
                <p>Gérer les comptes utilisateurs, bloquer, débloquer, impersonate.</p>
            </a>
            <a href="/admin/badges" class="admin-card">
                <i class="fa-solid fa-award"></i>
                <h3>Badges</h3>
                <p>Créer et gérer les badges disponibles sur la plateforme.</p>
            </a>
            <a href="/admin/auth" class="admin-card">
                <i class="fa-solid fa-key"></i>
                <h3>Authentification</h3>
                <p>Gérer les paramètres d'authentification administrateur.</p>
            </a>
        </div>
    </div>
</body>
</html>