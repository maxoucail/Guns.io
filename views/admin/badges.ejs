<%- include('../partials/head', { title: 'Admin — Badges' }) %>
<body class="admin-page">
    <%- include('../partials/nav', { user: user, currentPage: 'admin' }) %>

    <div class="admin-container">
        <div class="admin-header">
            <a href="/admin" class="admin-back">
                <i class="fa-solid fa-arrow-left"></i> Retour
            </a>
            <h1><i class="fa-solid fa-award"></i> Badges</h1>
            <p>Crée, modifie et gère les badges disponibles sur la plateforme.</p>
        </div>

        <div class="admin-card-content">
            <h3>Créer un nouveau badge</h3>
            <form action="/admin/badges" method="POST" class="admin-form">
                <div class="form-group">
                    <label for="badgeName">Nom du badge</label>
                    <input type="text" id="badgeName" name="name" placeholder="Early Supporter" required maxlength="50">
                </div>
                <div class="form-group">
                    <label for="badgeIcon">Icône (Font Awesome)</label>
                    <input type="text" id="badgeIcon" name="icon" placeholder="fa-solid fa-star" required>
                    <span class="form-hint">Ex: fa-solid fa-crown, fa-solid fa-fire, fa-solid fa-gem...</span>
                </div>
                <div class="form-group">
                    <label for="badgeDescription">Description</label>
                    <textarea id="badgeDescription" name="description" placeholder="Décris ce que ce badge représente..." rows="3" maxlength="200"></textarea>
                </div>
                <div class="form-group">
                    <label for="badgeColor">Couleur</label>
                    <input type="color" id="badgeColor" name="color" value="#e94560">
                </div>
                <button type="submit" class="btn btn-primary">
                    <i class="fa-solid fa-plus"></i>
                    Créer le badge
                </button>
            </form>
        </div>

        <div class="admin-card-content">
            <h3>Badges existants</h3>
            <% if (badges?.length) { %>
            <div class="admin-badges-grid">
                <% badges.forEach(function(badge) { %>
                <div class="admin-badge-card">
                    <div class="admin-badge-card-preview" style="color: <%= badge.color || '#e94560' %>">
                        <i class="fa-solid <%= badge.icon %>"></i>
                    </div>
                    <div class="admin-badge-card-info">
                        <h4><%= badge.name %></h4>
                        <p><%= badge.description || 'Aucune description' %></p>
                    </div>
                    <form action="/admin/badges/<%= badge._id || badge.id %>/delete" method="POST" onsubmit="return confirm('Supprimer le badge <%= badge.name %> ?')">
                        <button type="submit" class="btn btn-small btn-danger">
                            <i class="fa-solid fa-trash"></i>
                        </button>
                    </form>
                </div>
                <% }); %>
            </div>
            <% } else { %>
            <p class="muted">Aucun badge créé pour le moment.</p>
            <% } %>
        </div>
    </div>
</body>
</html>