<%- include('partials/head', { title: 'Éditeur de profil' }) %>
<link rel="stylesheet" href="/static/css/editor.css">
<body class="editor-page">
    <%- include('partials/nav', { user: user, currentPage: 'editor' }) %>

    <div class="editor-container">
        <!-- Left Panel: Controls -->
        <div class="editor-sidebar">
            <div class="editor-sidebar-header">
                <h2><i class="fa-solid fa-pen-to-square"></i> Éditeur</h2>
                <p>Personnalise chaque détail de ton profil.</p>
            </div>

            <!-- Sections / Tabs -->
            <div class="editor-tabs">
                <button class="editor-tab active" data-tab="general">
                    <i class="fa-solid fa-user"></i>
                    Général
                </button>
                <button class="editor-tab" data-tab="appearance">
                    <i class="fa-solid fa-palette"></i>
                    Apparence
                </button>
                <button class="editor-tab" data-tab="links">
                    <i class="fa-solid fa-link"></i>
                    Liens
                </button>
                <button class="editor-tab" data-tab="effects">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                    Effets
                </button>
                <button class="editor-tab" data-tab="music">
                    <i class="fa-solid fa-music"></i>
                    Musique
                </button>
                <button class="editor-tab" data-tab="social">
                    <i class="fa-solid fa-share-nodes"></i>
                    Réseaux
                </button>
            </div>

            <form id="editorForm" class="editor-form">
                <!-- General Panel -->
                <div class="editor-panel active" data-panel="general">
                    <div class="form-group">
                        <label>Avatar</label>
                        <div class="avatar-upload">
                            <img src="<%= pageConfig?.avatarUrl || 'https://github.com/' + user.username + '.png?size=80' %>" alt="Avatar" id="avatarPreview">
                            <input type="file" name="avatar" accept="image/*" id="avatarInput">
                            <label for="avatarInput" class="btn btn-small btn-ghost">
                                <i class="fa-solid fa-camera"></i> Changer
                            </label>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="displayName">Nom affiché</label>
                        <input type="text" id="displayName" name="displayName" value="<%= pageConfig?.displayName || '' %>" placeholder="Ton nom" maxlength="50">
                    </div>
                    <div class="form-group">
                        <label for="bio">Bio</label>
                        <textarea id="bio" name="bio" placeholder="Décris-toi en quelques mots..." rows="4" maxlength="300"><%= pageConfig?.bio || '' %></textarea>
                        <span class="form-hint char-count"><span id="bioCount">0</span>/300</span>
                    </div>
                    <div class="form-group">
                        <label for="pronouns">Pronoms</label>
                        <input type="text" id="pronouns" name="pronouns" value="<%= profile?.pronouns || '' %>" placeholder="il/lui, elle/elle, iel..." maxlength="20">
                    </div>
                </div>

                <!-- Appearance Panel -->
                <div class="editor-panel" data-panel="appearance">
                    <div class="form-group">
                        <label>Thème</label>
                        <div class="theme-selector">
                            <% const themes = [
                                { id: 'dark', name: 'Dark', bg: '#0a0a0a', accent: '#e94560' },
                                { id: 'midnight', name: 'Midnight', bg: '#0f0f23', accent: '#7b2ff7' },
                                { id: 'ocean', name: 'Ocean', bg: '#0a1628', accent: '#00d4ff' },
                                { id: 'sunset', name: 'Sunset', bg: '#1a0a0a', accent: '#ff6b35' },
                                { id: 'forest', name: 'Forest', bg: '#0a1a0a', accent: '#00ff88' },
                                { id: 'neon', name: 'Neon', bg: '#0a0a0a', accent: '#ff00ff' },
                                { id: 'cyberpunk', name: 'Cyberpunk', bg: '#0d0221', accent: '#ff2a6d' },
                                { id: 'dracula', name: 'Dracula', bg: '#282a36', accent: '#bd93f9' },
                                { id: 'nord', name: 'Nord', bg: '#2e3440', accent: '#88c0d0' },
                                { id: 'monokai', name: 'Monokai', bg: '#272822', accent: '#a6e22e' },
                                { id: 'gruvbox', name: 'Gruvbox', bg: '#282828', accent: '#fabd2f' },
                                { id: 'solarized', name: 'Solarized', bg: '#002b36', accent: '#2aa198' }
                            ]; %>
                            <% themes.forEach(function(theme) { %>
                            <label class="theme-option <%= (pageConfig?.theme || 'dark') === theme.id ? 'selected' : '' %>">
                                <input type="radio" name="theme" value="<%= theme.id %>" <%= (pageConfig?.theme || 'dark') === theme.id ? 'checked' : '' %>>
                                <span class="theme-swatch" style="background:<%= theme.bg %>">
                                    <span class="theme-swatch-accent" style="background:<%= theme.accent %>"></span>
                                </span>
                                <span class="theme-label"><%= theme.name %></span>
                            </label>
                            <% }); %>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="font">Police</label>
                        <select id="font" name="font">
                            <% const fonts = ['Inter', 'Space Grotesk', 'JetBrains Mono', 'Outfit', 'Plus Jakarta Sans', 'Sora', 'DM Sans', 'Manrope', 'Poppins', 'Playfair Display', 'Caveat', 'Press Start 2P', 'Bebas Neue', 'Pacifico', 'Monoton']; %>
                            <% fonts.forEach(function(font) { %>
                            <option value="<%= font %>" <%= pageConfig?.font === font ? 'selected' : '' %>><%= font %></option>
                            <% }); %>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="primaryColor">Couleur principale</label>
                        <div class="color-picker-wrapper">
                            <input type="color" id="primaryColor" name="accentColor" value="<%= pageConfig?.accentColor || '#e94560' %>">
                            <input type="text" id="primaryColorText" value="<%= pageConfig?.accentColor || '#e94560' %>" readonly>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="bgOpacity">Opacité du fond</label>
                        <input type="range" id="bgOpacity" name="overlayOpacity" min="0" max="100" value="<%= pageConfig?.overlayOpacity ?? 95 %>">
                        <span class="range-value"><%= pageConfig?.overlayOpacity ?? 95 %>%</span>
                    </div>
                </div>

                <!-- Links Panel -->
                <div class="editor-panel" data-panel="links">
                    <div class="links-container" id="linksContainer">
                        <% if (pageConfig?.custom_links?.length) { %>
                            <% pageConfig.custom_links.forEach(function(link, index) { %>
                            <div class="link-item" data-index="<%= index %>">
                                <div class="link-item-header">
                                    <span class="link-item-drag"><i class="fa-solid fa-grip-vertical"></i></span>
                                    <input type="text" name="custom_links[<%= index %>][label]" value="<%= link.label %>" placeholder="Titre du lien" class="link-title">
                                    <button type="button" class="link-item-remove" onclick="this.closest('.link-item').remove()">
                                        <i class="fa-solid fa-xmark"></i>
                                    </button>
                                </div>
                                <input type="url" name="custom_links[<%= index %>][url]" value="<%= link.url %>" placeholder="https://..." class="link-url">
                                <select name="custom_links[<%= index %>][icon]" class="link-icon-select">
                                    <option value="">Pas d'icône</option>
                                    <option value="fa-github" <%= link.icon === 'fa-github' ? 'selected' : '' %>>GitHub</option>
                                    <option value="fa-youtube" <%= link.icon === 'fa-youtube' ? 'selected' : '' %>>YouTube</option>
                                    <option value="fa-x-twitter" <%= link.icon === 'fa-x-twitter' ? 'selected' : '' %>>Twitter/X</option>
                                    <option value="fa-discord" <%= link.icon === 'fa-discord' ? 'selected' : '' %>>Discord</option>
                                    <option value="fa-instagram" <%= link.icon === 'fa-instagram' ? 'selected' : '' %>>Instagram</option>
                                    <option value="fa-twitch" <%= link.icon === 'fa-twitch' ? 'selected' : '' %>>Twitch</option>
                                    <option value="fa-tiktok" <%= link.icon === 'fa-tiktok' ? 'selected' : '' %>>TikTok</option>
                                    <option value="fa-spotify" <%= link.icon === 'fa-spotify' ? 'selected' : '' %>>Spotify</option>
                                    <option value="fa-solid fa-globe" <%= link.icon === 'fa-solid fa-globe' ? 'selected' : '' %>>Site web</option>
                                    <option value="fa-solid fa-envelope" <%= link.icon === 'fa-solid fa-envelope' ? 'selected' : '' %>>Email</option>
                                </select>
                            </div>
                            <% }); %>
                        <% } %>
                    </div>
                    <button type="button" class="btn btn-ghost btn-full" id="addLink">
                        <i class="fa-solid fa-plus"></i>
                        Ajouter un lien
                    </button>
                </div>

                <!-- Effects Panel -->
                <div class="editor-panel" data-panel="effects">
                    <div class="form-group">
                        <label>Effet de fond</label>
                        <div class="effects-grid">
                            <% const effectList = [
                                { id: 'none', name: 'Aucun', icon: 'fa-ban' },
                                { id: 'stars', name: 'Étoiles', icon: 'fa-star' },
                                { id: 'snow', name: 'Neige', icon: 'fa-snowflake' },
                                { id: 'bubbles', name: 'Bulles', icon: 'fa-circle' },
                                { id: 'matrix', name: 'Matrix', icon: 'fa-digital-tiling' },
                                { id: 'fireflies', name: 'Lucioles', icon: 'fa-fire' },
                                { id: 'confetti', name: 'Confetti', icon: 'fa-party-horn' },
                                { id: 'rain', name: 'Pluie', icon: 'fa-droplet' }
                            ]; %>
                            <% effectList.forEach(function(eff) { %>
                            <label class="effect-option <%= (pageConfig?.particles || 'none') === eff.id ? 'selected' : '' %>">
                                <input type="radio" name="particles" value="<%= eff.id %>" <%= (pageConfig?.particles || 'none') === eff.id ? 'checked' : '' %>>
                                <i class="fa-solid <%= eff.icon %>"></i>
                                <span><%= eff.name %></span>
                            </label>
                            <% }); %>
                        </div>
                    </div>
                    <div class="form-group">
                        <label>Cursor personnalisé</label>
                        <select name="cursorEffect">
                            <option value="none" <%= pageConfig?.cursorEffect === 'none' ? 'selected' : '' %>>Normal</option>
                            <option value="trail" <%= pageConfig?.cursorEffect === 'trail' ? 'selected' : '' %>>Trail</option>
                            <option value="sparkle" <%= pageConfig?.cursorEffect === 'sparkle' ? 'selected' : '' %>>Sparkle</option>
                            <option value="glow" <%= pageConfig?.cursorEffect === 'glow' ? 'selected' : '' %>>Glow</option>
                            <option value="dot" <%= pageConfig?.cursorEffect === 'dot' ? 'selected' : '' %>>Dot</option>
                            <option value="ring" <%= pageConfig?.cursorEffect === 'ring' ? 'selected' : '' %>>Ring</option>
                            <option value="star" <%= pageConfig?.cursorEffect === 'star' ? 'selected' : '' %>>Star</option>
                            <option value="heart" <%= pageConfig?.cursorEffect === 'heart' ? 'selected' : '' %>>Heart</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="usernameEffect" value="glitch" <%= pageConfig?.usernameEffect === 'glitch' ? 'checked' : '' %>>
                            <span>Effet Glitch sur le texte</span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="gradientBorder" <%= pageConfig?.bgType === 'gradient' ? 'checked' : '' %>>
                            <span>Bordures animées (gradient)</span>
                        </label>
                    </div>
                    <div class="form-group">
                        <label>
                            <input type="checkbox" name="showBadges" <%= pageConfig?.showBadges !== false ? 'checked' : '' %>>
                            <span>Afficher les badges</span>
                        </label>
                    </div>
                </div>

                <!-- Music Panel -->
                <div class="editor-panel" data-panel="music">
                    <div class="form-group">
                        <label>Rechercher de la musique</label>
                        <div class="music-search-wrapper">
                            <input type="text" id="musicSearch" placeholder="Artiste ou titre..." autocomplete="off">
                            <select id="musicSource">
                                <option value="deezer">Deezer</option>
                                <option value="youtube">YouTube</option>
                            </select>
                        </div>
                        <div class="music-results" id="musicResults"></div>
                    </div>
                    <% if (pageConfig?.music) { %>
                    <div class="music-playlist">
                        <label>Ta musique</label>
                        <div class="music-track">
                            <img src="<%= pageConfig.music.cover || '' %>" alt="<%= pageConfig.music.title %>" class="music-track-cover" onerror="this.style.display='none'">
                            <div class="music-track-info">
                                <span class="music-track-title"><%= pageConfig.music.title %></span>
                                <span class="music-track-artist"><%= pageConfig.music.artist %></span>
                            </div>
                            <input type="hidden" name="music[]" value="<%= safeJSON(pageConfig.music) %>">
                            <button type="button" class="btn btn-small btn-danger" onclick="this.closest('.music-playlist').innerHTML=''">
                                <i class="fa-solid fa-trash"></i>
                            </button>
                        </div>
                    </div>
                    <% } %>
                </div>

                <!-- Social Panel -->
                <div class="editor-panel" data-panel="social">
                    <div class="form-group">
                        <label for="socialGithub">GitHub</label>
                        <input type="text" id="socialGithub" name="social_links[github]" value="<%= (pageConfig?.social_links || []).find(s => s.platform === 'github')?.value || user.username %>" placeholder="Nom d'utilisateur GitHub">
                    </div>
                    <div class="form-group">
                        <label for="socialTwitter">Twitter / X</label>
                        <input type="text" id="socialTwitter" name="social_links[twitter]" value="<%= (pageConfig?.social_links || []).find(s => s.platform === 'twitter')?.value || '' %>" placeholder="@toncompte">
                    </div>
                    <div class="form-group">
                        <label for="socialDiscord">Discord</label>
                        <input type="text" id="socialDiscord" name="social_links[discord]" value="<%= (pageConfig?.social_links || []).find(s => s.platform === 'discord')?.value || '' %>" placeholder="tonpseudo">
                    </div>
                    <div class="form-group">
                        <label for="socialYoutube">YouTube</label>
                        <input type="url" id="socialYoutube" name="social_links[youtube]" value="<%= (pageConfig?.social_links || []).find(s => s.platform === 'youtube')?.value || '' %>" placeholder="https://youtube.com/@...">
                    </div>
                    <div class="form-group">
                        <label for="socialTwitch">Twitch</label>
                        <input type="text" id="socialTwitch" name="social_links[twitch]" value="<%= (pageConfig?.social_links || []).find(s => s.platform === 'twitch')?.value || '' %>" placeholder="twitch.tv/...">
                    </div>
                    <div class="form-group">
                        <label for="socialInstagram">Instagram</label>
                        <input type="text" id="socialInstagram" name="social_links[instagram]" value="<%= (pageConfig?.social_links || []).find(s => s.platform === 'instagram')?.value || '' %>" placeholder="@toncompte">
                    </div>
                    <div class="form-group">
                        <label for="socialTiktok">TikTok</label>
                        <input type="text" id="socialTiktok" name="social_links[tiktok]" value="<%= (pageConfig?.social_links || []).find(s => s.platform === 'tiktok')?.value || '' %>" placeholder="@toncompte">
                    </div>
                </div>

                <!-- Actions -->
                <div class="editor-actions">
                    <button type="submit" class="btn btn-primary btn-glow btn-full" id="saveProfile">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Sauvegarder les modifications
                    </button>
                    <button type="button" class="btn btn-ghost btn-full" id="resetProfile">
                        <i class="fa-solid fa-rotate"></i>
                        Réinitialiser
                    </button>
                </div>
            </form>
        </div>

        <!-- Right Panel: Live Preview -->
        <div class="editor-preview">
            <div class="editor-preview-header">
                <h3><i class="fa-solid fa-eye"></i> Aperçu en direct</h3>
                <div class="preview-device-toggle">
                    <button class="active" data-device="desktop"><i class="fa-solid fa-desktop"></i></button>
                    <button data-device="mobile"><i class="fa-solid fa-mobile-screen"></i></button>
                </div>
            </div>
            <div class="preview-frame">
                <iframe src="/<%= user.username %>?preview=true" id="previewFrame" sandbox="allow-same-origin allow-scripts" onload="this.contentWindow.document.body.classList.add('preview-mode')"></iframe>
            </div>
        </div>
    </div>

    <script src="/static/js/editor.js"></script>
</body>
</html>