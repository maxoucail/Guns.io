<%- include('partials/head', { title: (cfg.displayName || '@' + owner.username) + ' · link2me' }) %>
<%
  const fontFamily = cfg.font || 'Inter';
  const theme = cfg.theme || 'dark';
  const effect = cfg.particles || cfg.usernameEffect || 'none';
  const accentColor = cfg.accentColor || '#e94560';
  const socialLinks = cfg.social_links || [];
  const customLinks = cfg.custom_links || [];
  const music = cfg.music;
  const userBadges = typeof badges !== 'undefined' ? badges : [];
%>
<style>
  body { font-family: '<%= fontFamily %>', sans-serif; }
  :root {
    --primary: <%= accentColor %>;
    --primary-rgb: <%= parseInt(accentColor.slice(1,3), 16) || 233 %>, <%= parseInt(accentColor.slice(3,5), 16) || 69 %>, <%= parseInt(accentColor.slice(5,7), 16) || 96 %>;
  }
</style>
<link rel="stylesheet" href="/static/css/profile.css">
<body class="profile-page theme-<%= theme %> effect-<%= effect %>" data-profile="<%= owner.username %>" data-owner-id="<%= owner.id %>">

  <% if (effect && effect !== 'none') { %>
  <canvas id="effectsCanvas" class="effects-canvas"></canvas>
  <% } %>

  <% if (cfg.usernameEffect === 'glitch') { %>
  <div class="glitch-overlay"></div>
  <% } %>

  <div class="profile-container">
    <!-- Avatar Section -->
    <div class="profile-header">
      <div class="profile-avatar-wrapper <%= cfg.bgType === 'gradient' ? 'gradient-border' : '' %>">
        <img
          src="<%= cfg.avatarUrl || 'https://github.com/' + owner.username + '.png?size=200' %>"
          alt="<%= cfg.displayName || owner.username %>"
          class="profile-avatar"
          onerror="this.style.display='none';this.nextElementSibling.style.display='flex';"
        >
        <div class="profile-avatar-fallback" style="display:none;">
          <span><%= (cfg.displayName || owner.username || '?')[0].toUpperCase() %></span>
        </div>
        <% if (userBadges.length) { %>
        <div class="profile-badges">
          <% userBadges.forEach(function(badge) { %>
          <span class="profile-badge" title="<%= badge.name %>">
            <i class="fa-solid <%= badge.icon || 'fa-star' %>"></i>
          </span>
          <% }); %>
        </div>
        <% } %>
      </div>

      <h1 class="profile-name <%= cfg.usernameEffect === 'glitch' ? 'glitch-text' : '' %>" <%= cfg.usernameEffect === 'glitch' ? 'data-text="' + (cfg.displayName || owner.username) + '"' : '' %>>
        <%= cfg.displayName || ('@' + owner.username) %>
      </h1>

      <% if (cfg.bio) { %>
      <p class="profile-bio"><%= cfg.bio %></p>
      <% } %>

      <% if (cfg.location) { %>
      <span class="profile-location">
        <i class="fa-solid fa-location-dot"></i> <%= cfg.location %>
      </span>
      <% } %>
    </div>

    <!-- Socials -->
    <% if (socialLinks.length) { %>
    <div class="profile-socials">
      <% socialLinks.forEach(function(link) {
        const resolved = SocialLinks.url(link.platform, link.value);
        if (resolved && resolved !== '#') { %>
      <a href="<%= resolved %>" target="_blank" rel="noopener" class="profile-social-link" title="<%= link.platform %>">
        <%- SocialLinks.icon(link.platform) %>
      </a>
      <% } }); %>
    </div>
    <% } %>

    <!-- Custom Links -->
    <% if (customLinks.length) { %>
    <div class="profile-links">
      <% customLinks.forEach(function(link) { %>
      <a href="<%= link.url %>" target="_blank" rel="noopener" class="profile-link <%= cfg.bgType === 'gradient' ? 'gradient-border-link' : '' %>" data-link-id="<%= link.url %>">
        <% if (link.icon) { %><i class="fa-solid <%= link.icon %> profile-link-icon" style="color:<%= link.color || accentColor %>"></i><% } %>
        <span class="profile-link-title"><%= link.label %></span>
        <i class="fa-solid fa-arrow-right profile-link-arrow"></i>
      </a>
      <% }); %>
    </div>
    <% } %>

    <!-- Music Player -->
    <% if (music) { %>
    <div class="profile-music">
      <h3 class="profile-section-title">
        <i class="fa-solid fa-music"></i>
        Musique
      </h3>
      <div class="profile-music-track">
        <img src="<%= music.cover || '' %>" alt="<%= music.title %>" class="profile-music-cover" onerror="this.style.display='none'">
        <div class="profile-music-info">
          <span class="profile-music-title"><%= music.title %></span>
          <span class="profile-music-artist"><%= music.artist %></span>
        </div>
        <% if (music.preview) { %>
        <button class="profile-music-play" onclick="new Audio('<%= music.preview %>').play()">
          <i class="fa-solid fa-play"></i>
        </button>
        <% } %>
      </div>
    </div>
    <% } %>

    <!-- Footer -->
    <div class="profile-footer">
      <a href="/" class="profile-powered">
        <i class="fa-solid fa-gun"></i>
        Powered by link2me
      </a>
      <% if (isOwner) { %>
      <a href="/editor" class="profile-edit-link">
        <i class="fa-solid fa-pen-to-square"></i> Éditer
      </a>
      <% } %>
    </div>
  </div>

  <% if (cfg.cursorEffect && cfg.cursorEffect !== 'none') { %>
  <div class="custom-cursor cursor-<%= cfg.cursorEffect %>" id="customCursor"></div>
  <% } %>

  <script src="/static/js/effects.js"></script>
  <script src="/static/js/profile.js"></script>
</body>
</html>
