<%- include('partials/head', { title: 'Crée ton profil ultime' }) %>
<body class="landing-page">
    <%- include('partials/nav', { user: typeof user !== 'undefined' ? user : null, currentPage: 'landing' }) %>

    <!-- Hero Section -->
    <section class="hero" id="hero">
        <div class="hero-bg">
            <div class="hero-grid"></div>
            <div class="hero-glow hero-glow-1"></div>
            <div class="hero-glow hero-glow-2"></div>
            <div class="hero-particles" id="heroParticles"></div>
        </div>
        <div class="hero-content">
            <div class="hero-badge">
                <span class="hero-badge-dot"></span>
                Nouveau — Plus de 50 effets visuels
            </div>
            <h1 class="hero-title">
                Crée le profil
                <span class="hero-title-gradient">le plus stylé</span>
                <br>de tous les temps
            </h1>
            <p class="hero-subtitle">
                Guns.io te permet de créer une page de liens unique avec des effets visuels incroyables,
                des polices personnalisées, des badges exclusifs, et bien plus. Le tout gratuitement.
            </p>
            <div class="hero-actions">
                <a href="/auth/github" class="btn btn-primary btn-glow">
                    <i class="fa-brands fa-github"></i>
                    Commencer gratuitement
                </a>
                <a href="#demo" class="btn btn-ghost">
                    <i class="fa-solid fa-play"></i>
                    Voir la démo
                </a>
            </div>
            <div class="hero-stats">
                <div class="hero-stat">
                    <span class="hero-stat-number">10K+</span>
                    <span class="hero-stat-label">Profils créés</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">50+</span>
                    <span class="hero-stat-label">Effets visuels</span>
                </div>
                <div class="hero-stat">
                    <span class="hero-stat-number">100%</span>
                    <span class="hero-stat-label">Gratuit</span>
                </div>
            </div>
        </div>
        <div class="hero-scroll">
            <span>Scroll</span>
            <i class="fa-solid fa-chevron-down"></i>
        </div>
    </section>

    <!-- Features Section -->
    <section class="features" id="features">
        <div class="section-header">
            <span class="section-tag">Fonctionnalités</span>
            <h2 class="section-title">Tout ce dont tu as besoin<span class="text-gradient"> pour briller</span></h2>
            <p class="section-desc">Des outils puissants pour créer un profil qui te ressemble vraiment.</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fa-solid fa-wand-magic-sparkles"></i>
                </div>
                <h3>Effets Visuels</h3>
                <p>Plus de 50 effets : glitch, neon, gradient, blur, parallax, particules, et bien plus.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fa-solid fa-font"></i>
                </div>
                <h3>Polices Personnalisées</h3>
                <p>15+ polices Google Fonts pour donner du caractère à ton profil.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fa-solid fa-award"></i>
                </div>
                <h3>Badges Exclusifs</h3>
                <p>Débloque des badges uniques et affiche-les fièrement sur ton profil.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fa-solid fa-music"></i>
                </div>
                <h3>Musique Intégrée</h3>
                <p>Ajoute tes morceaux préférés depuis Deezer et YouTube directement sur ton profil.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fa-solid fa-palette"></i>
                </div>
                <h3>Thèmes & Couleurs</h3>
                <p>Des dizaines de thèmes et la possibilité de tout customiser comme tu veux.</p>
            </div>
            <div class="feature-card">
                <div class="feature-icon">
                    <i class="fa-solid fa-chart-simple"></i>
                </div>
                <h3>Statistiques</h3>
                <p>Track tes vues, tes clics, et découvre d'où viennent tes visiteurs.</p>
            </div>
        </div>
    </section>

    <!-- Demo / Preview Section -->
    <section class="demo" id="demo">
        <div class="section-header">
            <span class="section-tag">Aperçu</span>
            <h2 class="section-title">Un aperçu de ce que <span class="text-gradient">tu peux créer</span></h2>
            <p class="section-desc">Voici à quoi pourrait ressembler ton profil avec Guns.io.</p>
        </div>
        <div class="demo-preview">
            <div class="demo-frame">
                <div class="demo-frame-header">
                    <div class="demo-frame-dots">
                        <span></span><span></span><span></span>
                    </div>
                    <div class="demo-frame-url">guns.io/tonpseudo</div>
                </div>
                <div class="demo-frame-content">
                    <div class="demo-profile">
                        <div class="demo-avatar-wrapper">
                            <div class="demo-avatar">
                                <span class="demo-avatar-text">T</span>
                            </div>
                            <div class="demo-badge demo-badge-gold">
                                <i class="fa-solid fa-crown"></i>
                            </div>
                        </div>
                        <h3 class="demo-name">TonPseudo</h3>
                        <p class="demo-bio">Développeur & Créateur de contenu • Guns.io addict 🔥</p>
                        <div class="demo-links">
                            <a href="#" class="demo-link">
                                <i class="fa-brands fa-github"></i>
                                <span>GitHub</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a href="#" class="demo-link">
                                <i class="fa-brands fa-youtube"></i>
                                <span>YouTube</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a href="#" class="demo-link">
                                <i class="fa-brands fa-discord"></i>
                                <span>Discord</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                            <a href="#" class="demo-link">
                                <i class="fa-brands fa-x-twitter"></i>
                                <span>Twitter / X</span>
                                <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                        <div class="demo-music">
                            <div class="demo-music-player">
                                <i class="fa-solid fa-music"></i>
                                <div class="demo-music-info">
                                    <span class="demo-music-title">Blinding Lights</span>
                                    <span class="demo-music-artist">The Weeknd</span>
                                </div>
                                <div class="demo-music-visualizer">
                                    <span></span><span></span><span></span><span></span><span></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Testimonials / Reviews -->
    <section class="reviews" id="reviews">
        <div class="section-header">
            <span class="section-tag">Avis</span>
            <h2 class="section-title">Ce que nos utilisateurs <span class="text-gradient">en pensent</span></h2>
        </div>
        <div class="reviews-grid">
            <div class="review-card">
                <div class="review-stars">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
                <p class="review-text">"Franchement, c'est le meilleur créateur de page de liens que j'ai testé. Les effets sont oufs !"</p>
                <div class="review-author">
                    <span class="review-author-name">@streamer_fr</span>
                    <span class="review-author-role">Streamer Twitch</span>
                </div>
            </div>
            <div class="review-card">
                <div class="review-stars">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
                <p class="review-text">"J'ai switché de gun.lol à Guns.io et franchement aucune déception. C'est juste mieux sur tous les points."</p>
                <div class="review-author">
                    <span class="review-author-name">@dev_creative</span>
                    <span class="review-author-role">Développeur</span>
                </div>
            </div>
            <div class="review-card">
                <div class="review-stars">
                    <i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i><i class="fa-solid fa-star"></i>
                </div>
                <p class="review-text">"Le support est réactif, les features sont dingues, et tout ça gratuitement. Que demander de plus ?"</p>
                <div class="review-author">
                    <span class="review-author-name">@design_addict</span>
                    <span class="review-author-role">Designer UI/UX</span>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ -->
    <section class="faq" id="faq">
        <div class="section-header">
            <span class="section-tag">FAQ</span>
            <h2 class="section-title">Questions <span class="text-gradient">fréquentes</span></h2>
        </div>
        <div class="faq-list">
            <details class="faq-item">
                <summary>
                    <span>C'est vraiment gratuit ?</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </summary>
                <p>Oui, Guns.io est 100% gratuit. Pas de plans payants cachés, pas de fonctionnalités premium. Tout est accessible à tous.</p>
            </details>
            <details class="faq-item">
                <summary>
                    <span>Comment ça se compare à gun.lol ?</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </summary>
                <p>Guns.io offre plus d'effets visuels, plus de polices, une recherche musicale intégrée (Deezer + YouTube), et une interface plus moderne. Le tout gratuitement.</p>
            </details>
            <details class="faq-item">
                <summary>
                    <span>Puis-je utiliser mon propre domaine ?</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </summary>
                <p>Pas encore, mais c'est une fonctionnalité prévue prochainement. Pour l'instant, ton profil est accessible via guns.io/tonpseudo.</p>
            </details>
            <details class="faq-item">
                <summary>
                    <span>Mes données sont-elles sécurisées ?</span>
                    <i class="fa-solid fa-chevron-down"></i>
                </summary>
                <p>Absolument. Nous utilisons OAuth via GitHub pour l'authentification, et toutes les données sont chiffrées et stockées de manière sécurisée.</p>
            </details>
        </div>
    </section>

    <!-- CTA -->
    <section class="cta" id="cta">
        <div class="cta-content">
            <h2>Prêt à créer le profil <span class="text-gradient">le plus stylé</span> ?</h2>
            <p>Rejoins plus de 10 000 utilisateurs qui ont déjà choisi Guns.io.</p>
            <a href="/auth/github" class="btn btn-primary btn-glow btn-large">
                <i class="fa-brands fa-github"></i>
                Créer mon profil gratuitement
            </a>
        </div>
    </section>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-content">
            <div class="footer-brand">
                <a href="/" class="footer-logo">
                    <i class="fa-solid fa-gun"></i>
                    Guns.io
                </a>
                <p>Le meilleur créateur de pages de liens.</p>
            </div>
            <div class="footer-links">
                <a href="/legal">Mentions légales</a>
                <a href="/legal#privacy">Confidentialité</a>
                <a href="/legal#terms">Conditions</a>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; <%= new Date().getFullYear() %> Guns.io — Fait avec <i class="fa-solid fa-heart"></i> pour la communauté</p>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="/static/js/landing.js"></script>
    <script src="/static/js/effects.js"></script>
</body>
</html>
