# Environnement
NODE_ENV=production
PORT=3000
CLUSTER=true
WORKERS=auto

# Base URL publique (utilisée pour les callbacks OAuth)
BASE_URL=https://link2me.fr

# Session (générez une vraie clé : openssl rand -hex 64)
SESSION_SECRET=change_me_with_a_long_random_string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Trust proxy (1 si derrière nginx/cloudflare)
TRUST_PROXY=1

# Limites uploads
MAX_AVATAR_SIZE=2097152
MAX_BANNER_SIZE=5242880
