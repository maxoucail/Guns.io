# Environnement
NODE_ENV=production
PORT=3000
CLUSTER=true
WORKERS=auto

# Base URL publique (utilisée pour les callbacks OAuth)
BASE_URL=https://link2me.fr

# Session (générez une vraie clé : openssl rand -hex 64)
SESSION_SECRET=change_me_with_a_long_random_string

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Discord OAuth (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Trust proxy (1 si derrière nginx/cloudflare)
TRUST_PROXY=1

# ── Stockage GitHub ──────────────────────────────────────────────────────────
# Les uploads (avatar, bannière, image/gif/vidéo de fond) sont poussés sur GitHub
# via la Git Data API (blob + commit) → URL raw.githubusercontent.com
# Si les clés sont vides, le stockage local (public/uploads/) est utilisé en fallback.
#
# 1. Crée un Personal Access Token (classic) avec le scope "repo" :
#    https://github.com/settings/tokens
# 2. GITHUB_REPO = nom du dépôt ciblé (peut être ce même repo)
# 3. GITHUB_UPLOADS_BRANCH = branche dédiée (créée auto si absente, défaut : "uploads")

GITHUB_TOKEN=ghp_XXXXXXXXXXXXX
GITHUB_OWNER=maxoucail
GITHUB_REPO=Guns.io
GITHUB_UPLOADS_BRANCH=uploads

# Limites uploads (fallback local uniquement)
MAX_AVATAR_SIZE=8388608
MAX_BANNER_SIZE=8388608
